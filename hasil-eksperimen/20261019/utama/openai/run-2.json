      "file": "src/controllers/authController.js",
      "baris": 20,
      "fungsi": "exports.register",
      "jenis": "Regular Expression Denial of Service",
      "cwe": "CWE-1333",
      "kategori_owasp": "A06",
      "penjelasan": "Email dari body registrasi diuji dengan EMAIL_RE sebelum batas panjang 255 karakter diperiksa. Bagian regex di kedua sisi pemisah titik dapat sama-sama mencocokkan titik, sehingga email panjang berisi banyak titik dan akhiran yang gagal dapat memicu backtracking kuadratik. Endpoint tanpa autentikasi ini dapat digunakan untuk memblokir event loop sebelum permintaan ditolak.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/cutiController.js",
      "baris": 50,
      "fungsi": "exports.create",
      "jenis": "Mass Assignment Status Cuti",
      "cwe": "CWE-915",
      "kategori_owasp": "A01",
      "penjelasan": "Mahasiswa dapat mengirim field status pada POST /api/cuti/me, dan controller memasukkannya ke data yang diteruskan ke model.create. Model menggunakan status tersebut dalam INSERT, bukan selalu menetapkannya menjadi diajukan. Akibatnya, mahasiswa dapat langsung membuat pengajuan berstatus disetujui tanpa keputusan admin.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/krsController.js",
      "baris": 70,
      "fungsi": "exports.addItem",
      "jenis": "TOCTOU Penambahan Item KRS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "Status draft diperiksa sebelum pemanggilan model.addItem, sedangkan INSERT di model tidak memeriksa status header. Permintaan paralel dapat mengubah header menjadi submitted atau locked setelah pemeriksaan tetapi sebelum item dimasukkan. Tanpa penguncian yang menyatukan pemeriksaan dan mutasi, mahasiswa dapat menambahkan item pada KRS yang seharusnya tidak lagi dapat diubah.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/krsController.js",
      "baris": 87,
      "fungsi": "exports.removeItem",
      "jenis": "TOCTOU Penghapusan Item KRS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "Status item diperoleh melalui findItemOwned sebelum penghapusan, tetapi model.removeItem melakukan DELETE hanya berdasarkan id. Jika submit atau penguncian terjadi di antara kedua operasi tersebut, penghapusan tetap berjalan meskipun KRS sudah bukan draft. Tidak ada penguncian atau syarat status pada operasi penghapusan untuk mempertahankan aturan tersebut.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/krsController.js",
      "baris": 110,
      "fungsi": "exports.submit",
      "jenis": "Race Condition Validasi Kuota SKS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "Daftar item dan total SKS dibaca sebelum transisi status, sementara transition hanya memeriksa bahwa header masih draft. Permintaan penambahan item dapat selesai setelah daftar tersebut dibaca tetapi sebelum transisi, sehingga total aktual melampaui kuota meskipun validasi sebelumnya lolos. Tidak ada penguncian bersama atau validasi atomik terhadap item saat KRS menjadi submitted.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/mahasiswaController.js",
      "baris": 96,
      "fungsi": "exports.updateMe",
      "jenis": "Mass Assignment Profil Mahasiswa",
      "cwe": "CWE-915",
      "kategori_owasp": "A01",
      "penjelasan": "Body PUT /api/mahasiswa/me disalin seluruhnya ke data, dengan hanya field rekening yang dihapus. Model kemudian menggunakan seluruh nama properti tersebut sebagai kolom UPDATE tanpa allowlist field mahasiswa. Mahasiswa dapat mengubah field seperti nim, nama, dan field administratif lain yang seharusnya hanya diubah melalui endpoint admin.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/nilaiController.js",
      "baris": 120,
      "fungsi": "halamanKhs",
      "jenis": "Injeksi HTML Tersimpan",
      "cwe": "CWE-79",
      "kategori_owasp": "A05",
      "penjelasan": "Field nama dari endpoint pengelolaan mata kuliah dapat mengandung markup dan kemudian dimasukkan langsung melalui i.nama ke respons HTML KHS. Berbeda dari field lain, nilai ini tidak melewati escapeHtml sehingga markup tersimpan dapat mengubah struktur dan isi tampilan KHS. CSP dari helmet membatasi eksekusi banyak jenis skrip, tetapi tidak menetralkan injeksi markup tersebut.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/cutiModel.js",
      "baris": 53,
      "fungsi": "exports.findOwned",
      "jenis": "IDOR Pembacaan Pengajuan Cuti",
      "cwe": "CWE-639",
      "kategori_owasp": "A01",
      "penjelasan": "GET /api/cuti/me/:id meneruskan id pengajuan dan identitas mahasiswa pemanggil ke findOwned, tetapi query hanya memfilter c.id. Parameter mahasiswaId tidak digunakan untuk membatasi kepemilikan. Mahasiswa yang mengetahui UUID pengajuan lain dapat membaca alasan cuti, alamat dan nomor telepon yang didekripsi, serta identitas pemohon lain.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/mahasiswaModel.js",
      "baris": 55,
      "fungsi": "listFrom",
      "jenis": "SQL Injection",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Parameter q pada daftar mahasiswa diubah menjadi pola pencarian oleh listQuery, lalu diinterpolasikan langsung ke literal SQL dalam listFrom. Transformasi tersebut hanya mengamankan karakter wildcard LIKE, bukan tanda kutip SQL. Pengguna endpoint admin dapat menyisipkan ekspresi SQL yang dieksekusi oleh query penghitungan dan daftar dengan hak koneksi database aplikasi.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/mahasiswaModel.js",
      "baris": 145,
      "fungsi": "exports.updateByUserId",
      "jenis": "SQL Injection melalui Nama Properti",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Nama properti body PUT /api/mahasiswa/me diambil melalui Object.keys dan dirangkai tanpa validasi menjadi klausa SET. Placeholder hanya melindungi nilai properti, bukan nama kolom yang berasal dari pemanggil. Mahasiswa dapat menyisipkan ekspresi atau subquery melalui nama properti, termasuk menyalin data dari tabel lain ke field profil yang dikembalikan dalam respons.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/nilaiModel.js",
      "baris": 133,
      "fungsi": "exports.publishedBySemester",
      "jenis": "SQL Injection",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Parameter semester dari GET /api/nilai/me/khs hanya diperiksa sebagai string tidak kosong sebelum diteruskan ke fungsi ini. Nilainya kemudian diinterpolasikan langsung ke SQL, berbeda dari mahasiswaId yang menggunakan parameter terikat. Mahasiswa dapat menyisipkan kondisi SQL untuk melewati filter kepemilikan dan status published, sehingga nilai mahasiswa lain maupun nilai draft dapat terbaca.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
