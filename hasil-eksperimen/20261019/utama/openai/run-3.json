      "file": "src/models/nilaiModel.js",
      "baris": 133,
      "fungsi": "exports.publishedBySemester",
      "jenis": "SQL Injection pada Semester KHS",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Parameter semester dari GET /api/nilai/me/khs hanya diperiksa sebagai string tidak kosong sebelum diinterpolasikan langsung ke query. Mahasiswa dapat menyisipkan kondisi SQL yang mengubah logika WHERE dan melewati filter kepemilikan atau status published. Penggunaan parameter untuk mahasiswaId tidak melindungi interpolasi semester ini.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
