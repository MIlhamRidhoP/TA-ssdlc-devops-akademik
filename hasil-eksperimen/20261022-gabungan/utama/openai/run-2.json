      "file": "src/models/mahasiswaModel.js",
      "baris": 55,
      "fungsi": "listFrom",
      "jenis": "SQL Injection",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Parameter q dari GET /api/mahasiswa diubah menjadi pola oleh listQuery, lalu disisipkan langsung ke literal SQL dalam listFrom. Transformasi tersebut hanya menangani karakter khusus LIKE, bukan petik tunggal, sehingga pemanggil endpoint admin dapat menyisipkan ekspresi SQL untuk mengakses data di luar hasil pencarian yang diizinkan.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/mahasiswaModel.js",
      "baris": 145,
      "fungsi": "exports.updateByUserId",
      "jenis": "SQL Injection melalui Nama Properti",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Nama properti body PUT /api/mahasiswa/me diteruskan oleh updateMe sebagai kunci d, kemudian dirangkai menjadi bagian SET tanpa allowlist atau pengutipan identifier. Mahasiswa dapat menggunakan nama properti berisi fragmen SQL untuk menyisipkan ekspresi, termasuk membaca data users ke kolom nama yang kemudian dikembalikan dalam respons. Parameterisasi nilai properti tidak melindungi nama kolom yang dirangkai ini.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/nilaiModel.js",
      "baris": 133,
      "fungsi": "exports.publishedBySemester",
      "jenis": "SQL Injection",
      "cwe": "CWE-89",
      "kategori_owasp": "A05",
      "penjelasan": "Parameter semester dari GET /api/nilai/me/khs hanya diperiksa sebagai string tidak kosong sebelum diteruskan ke publishedBySemester dan disisipkan langsung ke SQL. Mahasiswa yang lolos requireConsent dapat menyisipkan kondisi SQL untuk melewati filter mahasiswa_id maupun status published dan membaca nilai yang tidak berhak diaksesnya.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/routes/cutiRoutes.js",
      "baris": 17,
      "fungsi": "PUT /:id/status",
      "jenis": "Otorisasi Admin Tidak Diterapkan",
      "cwe": "CWE-862",
      "kategori_owasp": "A01",
      "penjelasan": "Endpoint PUT /api/cuti/:id/status hanya dilindungi authenticate dan tidak memasang authorize('admin'). Pengguna terautentikasi, termasuk mahasiswa, dapat menentukan pengajuan melalui parameter id lalu menyetujui atau menolaknya karena updateStatus dan putuskan juga tidak memeriksa kewenangan pemohon.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/cutiController.js",
      "baris": 50,
      "fungsi": "exports.create",
      "jenis": "Manipulasi Status Awal Cuti",
      "cwe": "CWE-841",
      "kategori_owasp": "A01",
      "penjelasan": "Mahasiswa dapat mengirim status=disetujui melalui POST /api/cuti/me, lalu create menyalinnya ke data.status dan model.create menyimpannya ke pengajuan_cuti. Tidak ada pembatasan agar status awal selalu diajukan, sehingga pemohon dapat melewati tahap keputusan admin sejak pembuatan pengajuan.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/cutiModel.js",
      "baris": 53,
      "fungsi": "exports.findOwned",
      "jenis": "IDOR Pembacaan Pengajuan Cuti",
      "cwe": "CWE-639",
      "kategori_owasp": "A01",
      "penjelasan": "Parameter id dari GET /api/cuti/me/:id diteruskan bersama identitas mahasiswa pemohon, tetapi findOwned mengabaikan mahasiswaId dan hanya memfilter c.id. Mahasiswa yang mengetahui UUID pengajuan lain dapat membaca detail pengajuan tersebut, termasuk alasan, alamat cuti dan nomor telepon yang didekripsi.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/profilModel.js",
      "baris": 38,
      "fungsi": "exports.removeEmail",
      "jenis": "IDOR Penghapusan Email",
      "cwe": "CWE-639",
      "kategori_owasp": "A01",
      "penjelasan": "Parameter id dari DELETE /api/mahasiswa/me/email/:id mencapai DELETE email_mahasiswa yang hanya memeriksa id, meskipun controller telah meneruskan mahasiswaId pemohon. Mahasiswa yang mengetahui UUID email tambahan milik mahasiswa lain dapat menghapusnya karena kepemilikan tidak dimasukkan ke kondisi SQL.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/mahasiswaController.js",
      "baris": 96,
      "fungsi": "exports.updateMe",
      "jenis": "Mass Assignment Profil Mahasiswa",
      "cwe": "CWE-915",
      "kategori_owasp": "A01",
      "penjelasan": "Body PUT /api/mahasiswa/me disalin seluruhnya ke data, dengan hanya rekening yang dikeluarkan, lalu updateByUserId memperbarui setiap kolom berdasarkan kunci tersebut. Tidak ada allowlist field pembaruan mandiri atau pemanggilan pick dan RULES, sehingga mahasiswa dapat mengubah field administratif seperti nisn dan nama_ayah, serta mencoba mengubah pengaitan user_id.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/krsController.js",
      "baris": 70,
      "fungsi": "exports.addItem",
      "jenis": "Race Condition Status Penambahan KRS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "Permintaan POST /api/krs/me/items memeriksa status draft melalui pembacaan header, kemudian menjalankan INSERT terpisah yang tidak memeriksa status kembali. Permintaan submit yang berlangsung bersamaan dapat mengubah status setelah pemeriksaan tersebut, sehingga mahasiswa masih dapat menambahkan item ke KRS yang sudah submitted atau kemudian locked.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/krsController.js",
      "baris": 87,
      "fungsi": "exports.removeItem",
      "jenis": "Race Condition Status Penghapusan KRS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "Permintaan DELETE /api/krs/me/items/:itemId memeriksa status draft melalui findItemOwned, tetapi removeItem kemudian menghapus berdasarkan id saja. Perubahan status oleh permintaan bersamaan di antara pemeriksaan dan DELETE memungkinkan mahasiswa menghapus item setelah KRS tidak lagi berstatus draft karena tidak ada penguncian atau pemeriksaan status atomik.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/controllers/krsController.js",
      "baris": 110,
      "fungsi": "exports.submit",
      "jenis": "Race Condition Pemeriksaan Kuota SKS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "submit menghitung total SKS dari hasil listItems, memeriksa kuota, lalu mengubah status header melalui operasi terpisah. Mahasiswa dapat menjalankan penambahan item bersamaan setelah daftar dibaca tetapi sebelum transisi status, sehingga KRS yang melebihi kuota tetap menjadi submitted. Kondisi status pada transition tidak memastikan bahwa item yang disahkan masih sama dengan item yang diperiksa.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
