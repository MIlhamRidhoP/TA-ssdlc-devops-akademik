    {
      "file": "src/models/krsModel.js",
      "baris": 46,
      "fungsi": "exports.addItem",
      "jenis": "TOCTOU pada Penambahan KRS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "mata_kuliah_id dari POST /api/krs/me/items digunakan untuk INSERT setelah controller membaca status draft melalui query terpisah. INSERT tidak mengunci header atau memeriksa status secara atomik, sehingga permintaan paralel dengan submit dapat menambahkan item setelah pemeriksaan kuota atau setelah status menjadi submitted. Mahasiswa dapat melewati batas SKS dan mengubah KRS yang seharusnya tidak lagi dapat diedit.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
    },
    {
      "file": "src/models/krsModel.js",
      "baris": 65,
      "fungsi": "exports.removeItem",
      "jenis": "TOCTOU pada Penghapusan KRS",
      "cwe": "CWE-367",
      "kategori_owasp": "A06",
      "penjelasan": "itemId dari DELETE /api/krs/me/items/:itemId sudah diperiksa kepemilikannya, tetapi status draft hanya diperiksa sebelum DELETE yang terpisah. Permintaan submit paralel dapat mengubah status menjadi submitted di antara pemeriksaan dan penghapusan karena tidak ada penguncian atau pemeriksaan status atomik pada operasi penghapusan. Akibatnya, mahasiswa masih dapat menghapus item, termasuk membuat KRS yang sudah diajukan menjadi kosong.",
      "sifat": "vulnerability",
      "keyakinan": "high",
      "tanda": []
